@model ShiftManager.ViewModels.RegistrationResultViewModel
@{
    ViewData["Title"] = "Registration Successful";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-success">
            <div class="card-body p-4 text-center">
                <i class="bi bi-check-circle-fill display-1 text-success"></i>
                <h2 class="mt-3">Welcome to ShiftManager!</h2>
                <p class="lead">Your workspace <strong>@Model.CompanyName</strong> has been provisioned successfully.</p>

                <a href="@Model.WorkspaceUrl" class="btn btn-primary btn-lg mt-2">
                    <i class="bi bi-arrow-right-circle"></i> Go to Your Workspace
                </a>
            </div>
        </div>

        @if (Model.UserCredentials.Any())
        {
            <div class="card mt-4 border-warning">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="bi bi-key"></i> User Credentials</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        <i class="bi bi-exclamation-triangle text-warning"></i>
                        Save these temporary passwords now — they will not be shown again. Users should change their password on first login.
                    </p>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Temporary Password</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cred in Model.UserCredentials)
                                {
                                    <tr>
                                        <td>@cred.FullName</td>
                                        <td>@cred.Email</td>
                                        <td><code>@cred.TemporaryPassword</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="card mt-4">
            <div class="card-body">
                <h5><i class="bi bi-info-circle text-primary"></i> What's Next?</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-check2 text-success"></i> Login with your admin account</li>
                    <li class="mb-2"><i class="bi bi-check2 text-success"></i> Create shifts for your team</li>
                    <li class="mb-2"><i class="bi bi-check2 text-success"></i> Assign shifts to users</li>
                    <li class="mb-2"><i class="bi bi-check2 text-success"></i> Need more users? Upgrade to Pro for $5/seat</li>
                </ul>
                <p class="text-muted small">Your workspace URL: <code>@Model.WorkspaceUrl</code></p>
            </div>
        </div>
    </div>
</div>
