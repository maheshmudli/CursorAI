@{
    ViewData["Title"] = "Swap Requests";
    var slug = ViewBag.TenantSlug as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-arrow-left-right text-primary"></i> Shift Swap Requests</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#requestSwapModal">
        <i class="bi bi-plus-circle"></i> Request Swap
    </button>
</div>

<div id="swapsContainer">
    <div class="text-center p-4">
        <div class="spinner-border text-primary"></div>
    </div>
</div>

<!-- Request Swap Modal -->
<div class="modal fade" id="requestSwapModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Request Shift Swap</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="swapError" class="alert alert-danger d-none"></div>
                <div class="mb-3">
                    <label class="form-label">My Shift Assignment</label>
                    <select id="myAssignment" class="form-select">
                        <option value="">Loading your shifts...</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Target Assignment (shift to swap with)</label>
                    <select id="targetAssignment" class="form-select">
                        <option value="">Loading all shifts...</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="submitSwapBtn" class="btn btn-primary">Request Swap</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const slug = '@slug';

        async function loadSwaps() {
            const container = document.getElementById('swapsContainer');
            try {
                const resp = await fetch(`/t/${slug}/api/swaps`);
                if (!resp.ok) throw new Error('Failed to load');
                const swaps = await resp.json();

                if (!swaps.length) {
                    container.innerHTML = '<div class="text-center text-muted p-4"><i class="bi bi-arrow-left-right display-4"></i><p class="mt-2">No swap requests.</p></div>';
                    return;
                }

                const isAdmin = @(User.IsInRole("CompanyAdmin") ? "true" : "false");
                const currentUser = '@User.Identity?.Name';

                let html = `<div class="table-responsive"><table class="table table-hover">
                    <thead class="table-dark"><tr>
                        <th>Requesting</th><th>Their Shift</th>
                        <th>Target User</th><th>Target Shift</th>
                        <th>Status</th><th>Date</th><th>Actions</th>
                    </tr></thead><tbody>`;

                swaps.forEach(s => {
                    const statusBadge = s.status === 'Pending' ? 'warning text-dark' : s.status === 'Approved' ? 'success' : 'danger';
                    const reqDate = s.requestingShiftDate ? new Date(s.requestingShiftDate).toLocaleDateString('en-AU') : '';
                    const tgtDate = s.targetShiftDate ? new Date(s.targetShiftDate).toLocaleDateString('en-AU') : '';
                    const createdAt = new Date(s.createdAt).toLocaleDateString('en-AU');

                    html += `<tr>
                        <td>${s.requestingUser}</td>
                        <td>${reqDate} ${s.requestingShiftRole || ''}</td>
                        <td>${s.targetUser}</td>
                        <td>${tgtDate} ${s.targetShiftRole || ''}</td>
                        <td><span class="badge bg-${statusBadge}">${s.status}</span></td>
                        <td>${createdAt}</td>
                        <td>`;

                    if (s.status === 'Pending' && (isAdmin || s.targetUser === currentUser)) {
                        html += `<button class="btn btn-sm btn-success approve-btn" data-id="${s.id}"><i class="bi bi-check"></i> Approve</button>
                                 <button class="btn btn-sm btn-danger reject-btn" data-id="${s.id}"><i class="bi bi-x"></i> Reject</button>`;
                    }
                    html += '</td></tr>';
                });
                html += '</tbody></table></div>';
                container.innerHTML = html;

                document.querySelectorAll('.approve-btn').forEach(btn => {
                    btn.addEventListener('click', async function() {
                        const resp = await fetch(`/t/${slug}/api/swaps/${this.dataset.id}/approve`, { method: 'POST' });
                        if (resp.ok) loadSwaps();
                        else alert('Failed to approve');
                    });
                });
                document.querySelectorAll('.reject-btn').forEach(btn => {
                    btn.addEventListener('click', async function() {
                        const resp = await fetch(`/t/${slug}/api/swaps/${this.dataset.id}/reject`, { method: 'POST' });
                        if (resp.ok) loadSwaps();
                        else alert('Failed to reject');
                    });
                });
            } catch (e) {
                container.innerHTML = `<div class="alert alert-danger">Error: ${e.message}</div>`;
            }
        }

        async function loadAssignments() {
            try {
                // Load my shifts
                const myResp = await fetch(`/t/${slug}/api/shifts`);
                if (myResp.ok) {
                    const myShifts = await myResp.json();
                    const mySelect = document.getElementById('myAssignment');
                    mySelect.innerHTML = '<option value="">Select your shift...</option>';
                    myShifts.filter(s => s.assignedUserId).forEach(s => {
                        const date = new Date(s.date).toLocaleDateString('en-AU');
                        mySelect.innerHTML += `<option value="${s.id}">${date} - ${s.roleLabel} (${s.startTime}-${s.endTime})</option>`;
                    });
                }

                // Load all shifts for target
                const allResp = await fetch(`/t/${slug}/api/shifts`);
                if (allResp.ok) {
                    const allShifts = await allResp.json();
                    const tgtSelect = document.getElementById('targetAssignment');
                    tgtSelect.innerHTML = '<option value="">Select target shift...</option>';
                    allShifts.filter(s => s.assignedUserId).forEach(s => {
                        const date = new Date(s.date).toLocaleDateString('en-AU');
                        tgtSelect.innerHTML += `<option value="${s.id}">${date} - ${s.roleLabel} - ${s.assignedUserName || 'Unknown'}</option>`;
                    });
                }
            } catch (e) {}
        }

        document.getElementById('requestSwapModal').addEventListener('show.bs.modal', loadAssignments);

        document.getElementById('submitSwapBtn').addEventListener('click', async function() {
            const myAssignmentId = document.getElementById('myAssignment').value;
            const targetAssignmentId = document.getElementById('targetAssignment').value;
            const errDiv = document.getElementById('swapError');

            if (!myAssignmentId || !targetAssignmentId) {
                errDiv.textContent = 'Please select both shifts.';
                errDiv.classList.remove('d-none');
                return;
            }

            const resp = await fetch(`/t/${slug}/api/swaps`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ myAssignmentId: parseInt(myAssignmentId), targetAssignmentId: parseInt(targetAssignmentId) })
            });

            if (resp.ok) {
                bootstrap.Modal.getInstance(document.getElementById('requestSwapModal')).hide();
                loadSwaps();
            } else {
                const data = await resp.json().catch(() => ({}));
                errDiv.textContent = data.error || 'Failed to create swap request';
                errDiv.classList.remove('d-none');
            }
        });

        loadSwaps();
    </script>
}
