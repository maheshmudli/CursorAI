@model ShiftManager.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard - " + Model.TenantName;
    var slug = ViewBag.TenantSlug as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-speedometer2 text-primary"></i> @Model.TenantName Dashboard</h2>
        <p class="text-muted mb-0">
            Upcoming shifts: @Model.WindowStart.ToString("MMM d") – @Model.WindowEnd.ToString("MMM d, yyyy")
            <small class="badge bg-secondary ms-1">Next 4 weeks</small>
        </p>
    </div>
    @if (Model.IsAdmin)
    {
        <a href="/t/@slug/WorkspaceHome/Shifts" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Manage Shifts
        </a>
    }
</div>

<div class="row g-4">
    <!-- My Upcoming Shifts -->
    <div class="col-md-@(Model.IsAdmin ? "6" : "12")">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-person-check text-primary"></i> My Upcoming Shifts</h5>
                <span class="badge bg-primary">@Model.MyUpcomingShifts.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.MyUpcomingShifts.Any())
                {
                    <div class="text-center text-muted p-4">
                        <i class="bi bi-calendar-x display-4"></i>
                        <p class="mt-2">No upcoming shifts assigned to you.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var shift in Model.MyUpcomingShifts)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <strong>@shift.RoleLabel</strong>
                                        <div class="text-muted small">
                                            <i class="bi bi-calendar3"></i> @shift.Date.ToString("ddd, MMM d, yyyy")
                                            &nbsp;<i class="bi bi-clock"></i> @shift.StartTime – @shift.EndTime
                                        </div>
                                        @if (!string.IsNullOrEmpty(shift.Notes))
                                        {
                                            <div class="text-muted small"><i class="bi bi-sticky"></i> @shift.Notes</div>
                                        }
                                    </div>
                                    <div>
                                        <a href="/t/@slug/WorkspaceHome/RequestSwap?assignmentId=@shift.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-arrow-left-right"></i> Swap
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.IsAdmin)
    {
        <!-- Admin: All upcoming shifts -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-calendar-week text-success"></i> All Upcoming Shifts</h5>
                    <span class="badge bg-success">@Model.AllUpcomingShifts.Count</span>
                </div>
                <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                    @if (!Model.AllUpcomingShifts.Any())
                    {
                        <div class="text-center text-muted p-4">
                            <i class="bi bi-calendar-x display-4"></i>
                            <p class="mt-2">No upcoming shifts created yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var shift in Model.AllUpcomingShifts)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@shift.RoleLabel</strong>
                                            @if (shift.AssignedUserName != null)
                                            {
                                                <span class="badge bg-info text-dark ms-1">@shift.AssignedUserName</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Unassigned</span>
                                            }
                                            <div class="text-muted small">
                                                <i class="bi bi-calendar3"></i> @shift.Date.ToString("ddd, MMM d, yyyy")
                                                &nbsp;<i class="bi bi-clock"></i> @shift.StartTime – @shift.EndTime
                                            </div>
                                        </div>
                                        <a href="/t/@slug/WorkspaceHome/Shifts" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Pending Swap Requests -->
@if (Model.PendingSwaps.Any())
{
    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-arrow-left-right text-warning"></i> Pending Swap Requests</h5>
            <span class="badge bg-warning text-dark">@Model.PendingSwaps.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Requesting</th>
                        <th>Their Shift</th>
                        <th>Target</th>
                        <th>Target Shift</th>
                        <th>Requested</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var swap in Model.PendingSwaps)
                    {
                        <tr>
                            <td>@swap.RequestingUserName</td>
                            <td>@swap.RequestingShiftDate.ToString("MMM d") @swap.RequestingShiftRole</td>
                            <td>@swap.TargetUserName</td>
                            <td>@swap.TargetShiftDate.ToString("MMM d") @swap.TargetShiftRole</td>
                            <td>@swap.CreatedAt.ToString("MMM d")</td>
                            <td>
                                @if (Model.IsAdmin || swap.TargetUserName == User.Identity?.Name)
                                {
                                    <button class="btn btn-sm btn-success approve-swap" data-id="@swap.Id" data-slug="@slug">
                                        <i class="bi bi-check"></i> Approve
                                    </button>
                                    <button class="btn btn-sm btn-danger reject-swap" data-id="@swap.Id" data-slug="@slug">
                                        <i class="bi bi-x"></i> Reject
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.approve-swap').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.dataset.id;
                const slug = this.dataset.slug;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || document.cookie.match(/XSRF-TOKEN=([^;]+)/)?.[1] || '';
                const resp = await fetch(`/t/${slug}/api/swaps/${id}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }
                });
                if (resp.ok) location.reload();
                else alert('Failed to approve swap');
            });
        });
        document.querySelectorAll('.reject-swap').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.dataset.id;
                const slug = this.dataset.slug;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || document.cookie.match(/XSRF-TOKEN=([^;]+)/)?.[1] || '';
                const resp = await fetch(`/t/${slug}/api/swaps/${id}/reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }
                });
                if (resp.ok) location.reload();
                else alert('Failed to reject swap');
            });
        });
    </script>
    @Html.AntiForgeryToken()
}
