@model List<ShiftManager.ViewModels.TenantUserViewModel>
@{
    ViewData["Title"] = "Users";
    var slug = ViewBag.TenantSlug as string ?? "";
    int seatAllowance = ViewBag.SeatAllowance;
    int userCount = ViewBag.UserCount;
    bool canAddUser = ViewBag.CanAddUser;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-people text-primary"></i> Team Members</h2>
        <p class="text-muted mb-0">
            <span class="badge bg-primary">@userCount / @seatAllowance seats used</span>
            @if (userCount >= seatAllowance)
            {
                <span class="badge bg-danger ms-1">Seat limit reached</span>
            }
        </p>
    </div>
    @if (canAddUser)
    {
        <a href="/t/@slug/Seats/AddUser" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Add User
        </a>
    }
    else
    {
        <a href="/t/@slug/Seats/Upgrade" class="btn btn-warning">
            <i class="bi bi-unlock"></i> Buy More Seats ($5/seat)
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last Login</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <i class="bi bi-person-circle text-secondary"></i>
                            @user.FullName
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.Role == "CompanyAdmin")
                            {
                                <span class="badge bg-primary">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">User</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            @if (user.LastLogin.HasValue)
                            {
                                @user.LastLogin.Value.ToString("MMM d, yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">Never</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <div class="progress" style="height: 8px;">
        @{
            int pct = seatAllowance > 0 ? (int)((double)userCount / seatAllowance * 100) : 0;
        }
        <div class="progress-bar @(pct >= 100 ? "bg-danger" : pct >= 80 ? "bg-warning" : "bg-success")"
             style="width: @pct%"></div>
    </div>
    <small class="text-muted">@userCount of @seatAllowance seats used (@pct%)</small>
    @if (userCount >= seatAllowance)
    {
        <a href="/t/@slug/Seats/Upgrade" class="btn btn-sm btn-warning ms-3">
            <i class="bi bi-plus-circle"></i> Add Seat for $5 AUD
        </a>
    }
</div>
