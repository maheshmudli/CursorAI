@model ShiftManager.ViewModels.PlatformTenantsListViewModel
@{
    ViewData["Title"] = "All Tenants";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-buildings text-success"></i> All Tenants</h2>
    <span class="badge bg-secondary fs-6">@Model.TotalCount total</span>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Company</th>
                    <th>Slug / Route</th>
                    <th>Status</th>
                    <th>Tier</th>
                    <th>Seats</th>
                    <th>Users</th>
                    <th>Payment</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tenants)
                {
                    <tr>
                        <td><strong>@t.CompanyName</strong></td>
                        <td>
                            <code>/t/@t.Slug</code>
                            <a href="/t/@t.Slug" class="ms-1 text-muted" target="_blank">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-@(t.Status == "Active" ? "success" : "secondary")">@t.Status</span>
                        </td>
                        <td>
                            <span class="badge bg-@(t.Tier == "Pro" ? "warning text-dark" : "secondary")">@t.Tier</span>
                        </td>
                        <td>@t.SeatAllowance</td>
                        <td>@t.UserCount / @t.SeatAllowance</td>
                        <td>
                            <span class="badge bg-@(t.ValidationPaymentStatus == "Succeeded" ? "success" : t.ValidationPaymentStatus == "Failed" ? "danger" : "secondary")">
                                @t.ValidationPaymentStatus
                            </span>
                        </td>
                        <td>@t.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td>
                            <a asp-controller="PlatformDashboard" asp-action="TenantDetail" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Tenants" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
