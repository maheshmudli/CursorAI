@model ShiftManager.ViewModels.PlatformAccessLogsViewModel
@{
    ViewData["Title"] = "Access Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-activity text-warning"></i> Access Logs</h2>
    <span class="badge bg-secondary fs-6">@Model.TotalCount entries</span>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Company</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Last Login</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td><strong>@log.CompanyName</strong></td>
                        <td>@log.UserFullName</td>
                        <td>@log.UserEmail</td>
                        <td>
                            <span class="badge bg-@(log.Role == "CompanyAdmin" ? "primary" : "secondary")">@log.Role</span>
                        </td>
                        <td>@log.LastLoginAt.ToString("MMM d, yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="AccessLogs" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
