@model ShiftManager.ViewModels.PlatformRegistrationsViewModel
@{
    ViewData["Title"] = "Registration Attempts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-clipboard-data text-primary"></i> Registration Attempts</h2>
    <span class="badge bg-secondary fs-6">@Model.TotalCount total</span>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Company</th>
                    <th>Admin Email</th>
                    <th>Status</th>
                    <th>Payment Intent</th>
                    <th>Submitted</th>
                    <th>Failure</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Attempts)
                {
                    <tr>
                        <td><strong>@a.CompanyName</strong></td>
                        <td>@a.AdminEmail</td>
                        <td>
                            @{
                                var cls = a.Status switch
                                {
                                    "Completed" => "success",
                                    "PaymentFailed" => "danger",
                                    "PaymentPending" => "warning text-dark",
                                    "Abandoned" => "secondary",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@cls">@a.Status</span>
                        </td>
                        <td><code class="small">@(a.StripePaymentIntentId?.Length > 20 ? a.StripePaymentIntentId[..20] + "..." : a.StripePaymentIntentId ?? "—")</code></td>
                        <td>@a.CreatedAt.ToString("MMM d, yyyy HH:mm")</td>
                        <td class="text-muted small">@a.FailureReason</td>
                        <td>
                            @if (a.TenantId.HasValue)
                            {
                                <a asp-controller="PlatformDashboard" asp-action="TenantDetail" asp-route-id="@a.TenantId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Registrations" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
