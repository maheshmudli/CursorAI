@model PaymentPageModel
@{
    ViewData["Title"] = "Payment";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="h3 mb-3">Validate your card</h1>
        <p class="text-muted">
            We charge <strong>@Model.AmountDisplay</strong> to confirm your card for
            <strong>@Model.CompanyName</strong>. Your workspace is created only after this succeeds.
        </p>

        @Html.AntiForgeryToken()

        <form id="completeForm" asp-action="Complete" method="post">
            <input type="hidden" name="token" value="@Model.Token" />
        </form>

        <div class="card">
            <div class="card-body">
                <div id="messages" class="alert alert-danger d-none"></div>

                @if (Model.IsLiveStripe)
                {
                    <div id="payment-element" class="mb-3"></div>
                    <button id="payBtn" class="btn btn-primary w-100">Pay @Model.AmountDisplay</button>
                }
                else
                {
                    <div class="alert alert-warning small">
                        <strong>Developer mode:</strong> Stripe is not configured, so a simulated payment is used.
                        Configure <code>Stripe:SecretKey</code> for real card processing.
                    </div>
                    <button id="paySuccess" class="btn btn-success w-100 mb-2">Simulate successful payment</button>
                    <button id="payFail" class="btn btn-outline-danger w-100">Simulate failed payment</button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const token = '@Model.Token';
    const antiforgery = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const messages = document.getElementById('messages');
    const completeForm = document.getElementById('completeForm');
    function showError(msg) { messages.textContent = msg; messages.classList.remove('d-none'); }
</script>
@if (Model.IsLiveStripe)
{
<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripe = Stripe('@Model.PublishableKey');
    const elements = stripe.elements({ clientSecret: '@Model.ClientSecret' });
    const paymentElement = elements.create('payment');
    paymentElement.mount('#payment-element');

    document.getElementById('payBtn').addEventListener('click', async (e) => {
        e.preventDefault();
        const { error } = await stripe.confirmPayment({ elements, redirect: 'if_required' });
        if (error) { showError(error.message); return; }
        completeForm.submit();
    });
</script>
}
else
{
<script>
    async function simulate(success) {
        const body = new URLSearchParams({ token, success, __RequestVerificationToken: antiforgery });
        const res = await fetch('@Url.Action("ConfirmTest")', { method: 'POST', body });
        const data = await res.json();
        if (success && data.status === 'succeeded') { completeForm.submit(); }
        else { completeForm.submit(); } // failed path returns user to the form with a message
    }
    document.getElementById('paySuccess').addEventListener('click', (e) => { e.preventDefault(); simulate(true); });
    document.getElementById('payFail').addEventListener('click', (e) => { e.preventDefault(); simulate(false); });
</script>
}
}
