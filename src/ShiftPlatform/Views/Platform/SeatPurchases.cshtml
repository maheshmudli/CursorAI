@model PagedResult<SeatPurchaseRow>
@{
    ViewData["Title"] = "Seat purchases";
    ViewData["PagerAction"] = "SeatPurchases";
    ViewData["PagerPage"] = Model.Page;
    ViewData["PagerTotalPages"] = Model.TotalPages;
}
<h1 class="h3 mb-3">Seat purchases</h1>
<div class="card">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Company</th><th>Seats</th><th>Amount</th><th>Status</th><th>Applied</th><th>Payment Intent</th><th>Created</th></tr></thead>
            <tbody>
            @foreach (var s in Model.Items)
            {
                <tr>
                    <td>@s.CompanyName</td>
                    <td>@s.SeatsAdded</td>
                    <td>@s.AmountDisplay</td>
                    <td><span class="badge bg-@(s.Status == "succeeded" ? "success" : "secondary")">@s.Status</span></td>
                    <td>@(s.Applied ? "Yes" : "No")</td>
                    <td><code class="small">@s.StripePaymentIntentId</code></td>
                    <td>@s.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
            @if (!Model.Items.Any()) { <tr><td colspan="7" class="text-muted p-3">No seat purchases yet.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer"><partial name="_Pager" /></div>
</div>
