@model PagedResult<PaymentRow>
@{
    ViewData["Title"] = "Validation payments";
    ViewData["PagerAction"] = "Payments";
    ViewData["PagerPage"] = Model.Page;
    ViewData["PagerTotalPages"] = Model.TotalPages;
}
<h1 class="h3 mb-3">Validation payments</h1>
<div class="card">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Company</th><th>Amount</th><th>Currency</th><th>Status</th><th>Payment Intent</th><th>Created</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td>@p.CompanyName</td>
                    <td>@p.AmountDisplay</td>
                    <td>@p.Currency.ToUpperInvariant()</td>
                    <td><span class="badge bg-@(p.Status == "succeeded" ? "success" : "secondary")">@p.Status</span></td>
                    <td><code class="small">@p.StripePaymentIntentId</code></td>
                    <td>@p.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
            @if (!Model.Items.Any()) { <tr><td colspan="6" class="text-muted p-3">No payments yet.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer"><partial name="_Pager" /></div>
</div>
