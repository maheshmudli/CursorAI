@{
    ViewData["Title"] = "Workspace dashboard";
    var slug = ViewContext.RouteData.Values["tenantSlug"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Workspace dashboard</h1>
    <div>
        <a class="btn btn-outline-primary" href="/t/@slug/tenant/shifts">Shifts</a>
        @if (User.IsInRole(Roles.CompanyAdmin))
        {
            <a class="btn btn-outline-secondary" href="/t/@slug/tenant/users">Users and seats</a>
        }
    </div>
</div>
<p class="text-muted">Upcoming means the next four weeks.</p>

<div class="row">
    <div class="col-lg-8">
        <h2 class="h4">Assignments</h2>
        <table class="table table-striped" id="assignments">
            <thead><tr><th>Date</th><th>Time</th><th>Role</th><th>User</th><th>Assignment</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="col-lg-4">
        <h2 class="h4">Swap requests</h2>
        <form id="swap-form" class="border rounded p-3 mb-3">
            <label class="form-label">Your assignment id</label>
            <input class="form-control mb-2" name="requestingAssignmentId" type="number" required />
            <label class="form-label">Target assignment id</label>
            <input class="form-control mb-2" name="targetAssignmentId" type="number" required />
            <button class="btn btn-primary" type="submit">Request swap</button>
        </form>
        <div id="swaps"></div>
    </div>
</div>

@section Scripts {
    <script>
        const slug = '@slug';
        async function loadDashboard() {
            const response = await fetch(`/t/${slug}/api/dashboard`);
            const data = await response.json();
            document.querySelector('#assignments tbody').innerHTML = data.assignments.map(a => `
                <tr><td>${a.date}</td><td>${a.startTime}-${a.endTime}</td><td>${a.roleLabel}</td><td>${a.userName}</td><td>${a.assignmentId}</td></tr>`).join('');
        }
        async function loadSwaps() {
            const response = await fetch(`/t/${slug}/api/swaps`);
            const data = await response.json();
            document.getElementById('swaps').innerHTML = data.map(s => `
                <div class="card mb-2"><div class="card-body">
                    <strong>${s.status}</strong>: ${s.requestingShift} for ${s.targetShift}
                    <div class="mt-2">
                        <button class="btn btn-sm btn-success" onclick="resolveSwap(${s.id}, 'approve')">Approve</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="resolveSwap(${s.id}, 'reject')">Reject</button>
                    </div>
                </div></div>`).join('');
        }
        async function resolveSwap(id, action) {
            await fetch(`/t/${slug}/api/swaps/${id}/${action}`, { method: 'POST' });
            await loadDashboard();
            await loadSwaps();
        }
        document.getElementById('swap-form').addEventListener('submit', async event => {
            event.preventDefault();
            const form = new FormData(event.target);
            await fetch(`/t/${slug}/api/swaps`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    requestingAssignmentId: Number(form.get('requestingAssignmentId')),
                    targetAssignmentId: Number(form.get('targetAssignmentId'))
                })
            });
            event.target.reset();
            await loadSwaps();
        });
        loadDashboard();
        loadSwaps();
    </script>
}
